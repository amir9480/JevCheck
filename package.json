  "scripts": {
    "dev": "vite",
    "dev:chrome": "concurrently -k -n vite,chrome \"vite\" \"node scripts/launch-chrome.mjs\"",
    "dev:google-chrome": "concurrently -k -n vite,chrome \"vite\" \"node scripts/launch-chrome.mjs --google-chrome\"",
    "dev:firefox": "node scripts/dev-firefox.mjs",
    "build": "tsc --noEmit && vite build",
    "build:chrome": "vite build",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "package": "pnpm build && node scripts/package.mjs",
    "package:firefox": "tsc --noEmit && vite build --mode firefox && node scripts/package.mjs --firefox",
    "lint:firefox": "web-ext lint --source-dir build-firefox"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "less"
    ]
  }
